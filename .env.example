# ─── Server ──────────────────────────────────────
NODE_ENV=development
PORT=8000
LOG_LEVEL=info

# ─── PostgreSQL (Docker) ────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=booking_go
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ─── MongoDB (Docker) ───────────────────────────
MONGODB_PORT=27017
MONGODB_USER=mongo
MONGODB_PASSWORD=mongo
MONGODB_DB=booking_go
MONGODB_URI=mongodb://mongo:mongo@localhost:27017/booking_go?authSource=admin

# ─── Redis (Docker) ─────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis

# ─── Authentication ─────────────────────────────
JWT_ACCESS_SECRET=your_access_secret_change_this_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_change_this_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ─── CORS ───────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ─── Rate Limiting ──────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ─── Frontend URL (for email links) ─────────────
FRONTEND_URL=http://localhost:3000

# ─── Docker Admin UIs ───────────────────────────
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@bookinggo.dev
PGADMIN_PASSWORD=admin
MONGO_EXPRESS_PORT=8081
REDISINSIGHT_PORT=5540

# ─── Ollama (Local LLM) ─────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
