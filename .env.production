# ─── Server ──────────────────────────────────────
NODE_ENV=production
PORT=8000
LOG_LEVEL=info

# ─── PostgreSQL (Docker internal) ───────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=booking_go
POSTGRES_USER=booking_admin
POSTGRES_PASSWORD=booking_pg_secret

# ─── MongoDB (Docker internal) ──────────────────
MONGODB_PORT=27017
MONGODB_USER=booking_admin
MONGODB_PASSWORD=booking_mongo_secret
MONGODB_DB=booking_go
MONGODB_URI=mongodb://booking_admin:booking_mongo_secret@mongodb:27017/booking_go?authSource=admin

# ─── Redis (Docker internal) ────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=booking_redis_secret

# ─── Authentication ─────────────────────────────
JWT_ACCESS_SECRET=demo_access_secret_change_for_real_production_use
JWT_REFRESH_SECRET=demo_refresh_secret_change_for_real_production_use
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ─── CORS ───────────────────────────────────────
# In production-demo the frontend proxies API calls,
# so requests come from the web container.
CORS_ORIGIN=*

# ─── Rate Limiting ──────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# ─── Frontend URL (for email links etc.) ────────
# This will be the Cloudflare quick-tunnel URL.
# Updated automatically by demo-start.sh at runtime.
FRONTEND_URL=http://localhost:3000
