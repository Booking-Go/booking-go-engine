# ─── Server ──────────────────────────────────────
NODE_ENV=production
PORT=8000
LOG_LEVEL=info

# ─── PostgreSQL (Docker internal) ───────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=booking_go
POSTGRES_USER=booking_admin
POSTGRES_PASSWORD=your_pg_password_here

# ─── MongoDB (Docker internal) ──────────────────
MONGODB_PORT=27017
MONGODB_USER=booking_admin
MONGODB_PASSWORD=your_mongo_password_here
MONGODB_DB=booking_go
MONGODB_URI=mongodb://booking_admin:your_mongo_password_here@mongodb:27017/booking_go?authSource=admin

# ─── Redis (Docker internal) ────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# ─── Authentication ─────────────────────────────
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ─── CORS ───────────────────────────────────────
CORS_ORIGIN=*

# ─── Rate Limiting ──────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# ─── Frontend URL (for email links etc.) ────────
FRONTEND_URL=http://localhost:3000

# ─── Firebase (Push Notifications) ──────────────
# Service account JSON (single line) — download from Firebase Console
FIREBASE_SERVICE_ACCOUNT=

# ─── Ollama (Local LLM) ─────────────────────────
# Use Docker-internal hostname in production compose
OLLAMA_HOST=http://ollama:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
